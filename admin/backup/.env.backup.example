# Copie para ".env.backup.local" (esse arquivo nunca vai para o GitHub).
# Supabase → botão "Connect" (topo) → aba "Connection String" → "Session pooler".
# Troque [YOUR-PASSWORD] pela senha do banco criada no passo A.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Só para restaurar em outro projeto (destino):
# SUPABASE_DB_URL_DESTINO=postgresql://postgres.yyyyyyyy:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Pasta onde os backups são salvos (padrão: ~/TSpa-backups)
# BACKUP_DIR=$HOME/TSpa-backups
