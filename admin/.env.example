# Copie este arquivo para ".env.local" e preencha com os dados do Supabase
# (Supabase → Project Settings → API).
#
# Use SOMENTE a chave pública: "publishable" (sb_publishable_...) ou "anon".
# NUNCA coloque aqui a chave "secret" / "service_role".
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLIC_KEY=cole-aqui-a-chave-publica
