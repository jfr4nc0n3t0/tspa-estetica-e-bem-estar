{
  "name": "tspa-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174",
    "check": "tsc --noEmit",
    "dev:local": "vite --port 5174 --mode docker",
    "local:up": "sh local/start.sh",
    "local:stop": "sh local/compose.sh stop",
    "local:reset": "sh local/compose.sh down -v",
    "backup": "sh backup/backup.sh",
    "restore": "sh backup/restore.sh",
    "push:keys": "node scripts/vapid-keys.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "5.6.3",
    "vite": "^5.4.20"
  }
}
